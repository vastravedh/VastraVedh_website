rules_version = '2';

// All writes to Firestore happen server-side via the Firebase Admin SDK, which
// bypasses these rules. Therefore clients get read-only access to catalogue
// data and NO direct write access. Orders are not client-readable (they hold
// customer PII) — only the server reads them for the admin dashboard.
service cloud.firestore {
  match /databases/{database}/documents {

    // Public catalogue data (custom products + uploaded-image maps + category
    // images) can be read by anyone; writes are server-only.
    match /products/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /meta/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Orders contain customer PII: no client access at all.
    match /orders/{doc} {
      allow read, write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
